# Local MongoDB: mongodb://127.0.0.1:27017/jobportal
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/jobportal?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/jobportal?retryWrites=true&w=majority
PORT=5000
# Optional private resume directory. Defaults to server/private_uploads/resumes.
RESUME_STORAGE_PATH=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLIENT_ORIGIN=http://localhost:5173
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
